<?xml version="1.0" encoding="utf-8"?>
<!--
  The settings page skeleton (docs/04 P2-8 item 1, docs/02 §8.1's `SettingsActivity`): grouped rows
  (源 / 播放 / 刷新 / 诊断 / 关于), one vertical focus path, header carrying the BACK contract so a
  screenshot proves the level the user is on.

  The rows themselves are inflated into `settings_rows` by the activity — the group set and its order
  come from `SettingsCatalog`, so what the page shows is unit-tested rather than re-listed in XML.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:orientation="vertical">

    <TextView
        android:id="@+id/settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF17171E"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/settings_title"
        android:textColor="#FFB9B9C6"
        android:textSize="16sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/settings_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
