<?xml version="1.0" encoding="utf-8"?>
<!--
  The diagnostics panel (docs/03 §7): 运行概览 on the left, 实时日志 on the right, and the §7.3
  actions under the header. Two scrolling panes instead of one so a tester can read the overview while
  the log keeps scrolling; every control is a focusable framework view (no leanback card needed).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:orientation="vertical">

    <TextView
        android:id="@+id/diag_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF17171E"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:text="@string/diag_title"
        android:textColor="#FFB9B9C6"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="6dp">

        <Button
            android:id="@+id/diag_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true" />

        <Button
            android:id="@+id/diag_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/diag_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/diag_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:text="@string/diag_export" />

        <Button
            android:id="@+id/diag_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:text="@string/diag_clear" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp">

        <EditText
            android:id="@+id/diag_search_field"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/diag_search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFE6E6E6"
            android:textColorHint="#FF6A6A78"
            android:textSize="14sp" />

        <Button
            android:id="@+id/diag_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:text="@string/diag_search" />

        <Button
            android:id="@+id/diag_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:text="@string/diag_copy" />

        <ProgressBar
            android:id="@+id/diag_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/diag_overview_title"
                android:textColor="#FF7AC7FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/diag_overview_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FF17171E">

                <TextView
                    android:id="@+id/diag_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textColor="#FFDADAE4"
                    android:textSize="13sp" />
            </ScrollView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/diag_log_title"
                android:textColor="#FF7AC7FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/diag_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FF0B0B10">

                <TextView
                    android:id="@+id/diag_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="#FF9BE39B"
                    android:textSize="11sp" />
            </ScrollView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
