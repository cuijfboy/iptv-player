<?xml version="1.0" encoding="utf-8"?>
<!--
  One subscription row: identity on the left, the three remote actions on the right.

  Every action is a focusable button rather than a hidden gesture, because docs/02 §8.2's contract is
  "reachable with the arrow keys only" — a context menu or a swipe has no remote equivalent. The
  enable switch is a button whose label is the *state* the press would produce (`source_disable` /
  `source_enable`), so what is on screen and what the switch does cannot disagree.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:background="#FF17171E"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    tools:targetApi="o">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/source_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6E6E6"
                android:textSize="20sp"
                tools:text="我的源" />

            <TextView
                android:id="@+id/source_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FF7A7A88"
                android:textSize="14sp"
                tools:text="已启用" />

        </LinearLayout>

        <TextView
            android:id="@+id/source_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9A9AA5"
            android:textSize="14sp"
            tools:text="https://example.com/list.m3u" />

        <TextView
            android:id="@+id/source_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9A9AA5"
            android:textSize="14sp"
            tools:text="尚未取回" />

    </LinearLayout>

    <Button
        android:id="@+id/source_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/source_disable" />

    <Button
        android:id="@+id/source_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/source_edit" />

    <Button
        android:id="@+id/source_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/source_delete" />

</LinearLayout>
