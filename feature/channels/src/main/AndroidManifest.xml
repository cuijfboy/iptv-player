<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <!--
      The library manifest has to repeat the TV hardware story because lint reads it on its own:
      `:app` declares leanback as required and the touchscreen as optional, but a library that ships
      an activity is checked as if it were the whole app. `MissingLeanbackLauncher` is suppressed at
      the manifest level for the same reason: the LEANBACK_LAUNCHER filter lives on `:app`'s
      MainActivity, and adding a second one here would put a second icon on the TV home screen.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application>

        <!--
          P1-2 browse screen (docs/02 §8.1 "BrowseActivity → ChannelListFragment"). The list is a
          view inside the activity for now — the fragment + navigation split lands with the real
          navigation work (player/EPG tabs, P1-4/P3-1) and would only add ceremony here.

          `exported="true"` is here for the P1-2 device proof (`adb shell am start -n
          ilab.iptv.player/ilab.iptv.player.feature.channels.BrowseActivity`); `MainActivity` stays
          the only launcher entry. Tighten it back when QA no longer drives this screen by adb.
        -->
        <activity
            android:name=".BrowseActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <!--
              P2-9: the launcher and the first-run wizard both open this screen through
              `BrowseContract.ACTION_BROWSE` (action + setPackage) instead of referencing the class,
              so `:app` keeps the "no feature class on my compile path" property and the wizard's 开看
              step can carry a hint with the intent.
            -->
            <intent-filter>
                <action android:name="ilab.iptv.player.action.BROWSE" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          P3-2 search screen. Same reasoning as BrowseActivity for `exported="true"`: QA drives the
          remote-only input path from adb (`am start -n ilab.iptv.player/…search.SearchActivity`).
        -->
        <activity
            android:name=".search.SearchActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

    </application>

</manifest>
