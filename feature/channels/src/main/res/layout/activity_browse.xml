<?xml version="1.0" encoding="utf-8"?>
<!-- Grouped channel list (docs/02 §8.1). One vertical focus path: header → rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:orientation="vertical">

    <TextView
        android:id="@+id/browse_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF17171E"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/browse_loading"
        android:textColor="#FFB9B9C6"
        android:textSize="16sp" />

    <!--
      P2-6: the regular way to get real channels onto the device (import) plus the entrance to the
      source-management page. Both sit above the list so DPAD_UP from the first row reaches them and
      the remote-only path stays intact.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/import_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/browse_import_action" />

        <Button
            android:id="@+id/open_sources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/browse_sources_action" />

        <!--
          P2-2: the two list-wide filters. They live next to import/sources so DPAD_UP from the first
          row reaches them, and so hiding a channel is reversible without a manager screen (P3-4).
        -->
        <Button
            android:id="@+id/filter_favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/browse_filter_favorites_off" />

        <Button
            android:id="@+id/filter_hidden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/browse_filter_hidden_hidden" />
        <!-- P2-8: the settings level itself (docs/02 §8.1 `SettingsActivity`). -->
        <Button
            android:id="@+id/open_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/browse_settings_action" />
        <!--
          P3-1: the EPG grid. Same contract trick as the settings button — an action string in
          :core:ui, so this module never depends on :feature:epg (docs/02 §3.2).
        -->
        <Button
            android:id="@+id/open_epg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/browse_epg_action" />

    </LinearLayout>

    <!-- clipChildren=false: a focused row scales up and must not be clipped at the list edges. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="12dp"
            android:scrollbars="none" />

    </FrameLayout>

</LinearLayout>
