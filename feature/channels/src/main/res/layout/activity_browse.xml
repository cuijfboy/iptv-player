<?xml version="1.0" encoding="utf-8"?>
<!-- Grouped channel list (docs/02 §8.1). One vertical focus path: header → rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:orientation="vertical">

    <TextView
        android:id="@+id/browse_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF17171E"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/browse_loading"
        android:textColor="#FFB9B9C6"
        android:textSize="16sp" />

    <!-- P2-6 slice: the regular way to get real channels onto the device (see 19-本地导入验证.md).
         DPAD_UP from the first row reaches it, so the remote-only path stays intact. -->
    <Button
        android:id="@+id/import_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:text="@string/browse_import_action" />

    <!-- clipChildren=false: a focused row scales up and must not be clipped at the list edges. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="12dp"
            android:scrollbars="none" />

    </FrameLayout>

</LinearLayout>
