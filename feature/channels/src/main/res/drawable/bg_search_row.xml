<?xml version="1.0" encoding="utf-8"?>
<!-- One result row of the P3-2 search screen: a focused state the remote can see at 10 feet. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF2A2A38" />
            <stroke
                android:width="2dp"
                android:color="#FFFFB84D" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF16161C" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
