<?xml version="1.0" encoding="utf-8"?>
<!--
  docs/02 §8.2 focus feedback: highlight fill + accent stroke when focused, quiet fill otherwise.

  P3-7 item 2: the fill and the stroke are the shared tokens from `:core:design`, not this module's
  own pair — a focused row, a focused search key and a focused settings row are the same state.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <stroke
                android:width="@dimen/focus_stroke_width"
                android:color="@color/focus_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF17171E" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>
