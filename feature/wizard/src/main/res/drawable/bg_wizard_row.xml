<?xml version="1.0" encoding="utf-8"?>
<!--
  The 选源 summary row and the built-in rows on the 二级页 (NEW-1). They are focusable because the
  remote has to be able to reach and scroll them, so they need a visible focus state; they draw it
  from the shared palette in `:core:design` (docs/02 §8.2 one focus language), not from a local guess.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <stroke
                android:width="@dimen/focus_stroke_width"
                android:color="@color/focus_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF17171E" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>
