    <dimen name="wizard_horizontal_padding">48dp</dimen>
    <dimen name="wizard_vertical_padding">24dp</dimen>
    <dimen name="wizard_header_min_height">36dp</dimen>
    <dimen name="wizard_hint_min_height">24dp</dimen>
    <dimen name="wizard_section_gap">12dp</dimen>
    <dimen name="wizard_button_min_height">48dp</dimen>
    <dimen name="wizard_button_gap">8dp</dimen>
    <dimen name="wizard_row_min_height">48dp</dimen>
    <dimen name="wizard_row_gap">4dp</dimen>
</resources>
