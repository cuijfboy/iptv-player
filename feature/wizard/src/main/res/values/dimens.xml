<?xml version="1.0" encoding="utf-8"?>
<!--
  The numbers `WizardPanels` budgets the first screen with (NEW-1). They are resources rather than
  literals in the layout so `WizardPanelLayoutTest` can read this file back and refuse to let the XML
  drift from the model — the same guard `InfoBarLayoutTest` puts on the player's info bar.
-->
