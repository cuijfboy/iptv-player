<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus feedback for the player's controls. The docs/02 §8.2 default highlight is switched off on the
  view, so the focused state has to be ours: brighter fill + a visible stroke.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF0C674" />
            <corners android:radius="8dp" />
            <stroke
                android:width="3dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
