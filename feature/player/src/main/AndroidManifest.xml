<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <!--
      P1-7 item 1: the playback foreground service. FOREGROUND_SERVICE is the API 28+ requirement;
      FOREGROUND_SERVICE_MEDIA_PLAYBACK is the API 34+ one, and this app targets 35, so both must be
      declared or the service throws on start.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- P1-7 item 5: the network-restore listener reads the default network's availability. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Same library-manifest caveat as :feature:channels: lint reads a library that ships an activity
      as if it were the whole app, so the TV hardware story and the launcher suppression are repeated
      here. The only LEANBACK_LAUNCHER stays on :app's MainActivity.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application>
        <!--
          P1-4 player screen (docs/02 §8.1). It is started through PlayerContract's action rather
          than by class name, so :feature:channels never needs this module on its compile path
          (docs/02 §3.2: no feature to feature dependency). PlayerContract.intent() pins
          `setPackage`, so only our own app can bind this filter; the device proof still drives it
          with `adb shell am start -a ilab.iptv.player.action.PLAY`, passing CHANNEL_ID as a long
          extra.
        -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="ilab.iptv.player.action.PLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          P1-7 item 1/2: the playback foreground service (docs/02 §7.2 P1/P4). `exported=true` is
          required by Media3 — the system's media control and the TV's own UI bind to the session
          through this component. `mediaPlayback` is the foreground-service type that tells the
          platform this process must not be frozen while the user is watching.

          The action string is media3's; it must match `MediaSessionService.SERVICE_INTERFACE`.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Media3's media-button router. Without it a KEYCODE_MEDIA_* press that is delivered while the
          player screen is not focused has nowhere to go; it re-delivers the event to PlaybackService
          (P1-7 item 2).
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
