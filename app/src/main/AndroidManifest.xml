<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      P2-5: the scheduled refresh runs as a WorkManager long-running worker, i.e. as the foreground
      service `androidx.work.impl.foreground.SystemForegroundService`. `FOREGROUND_SERVICE` is required
      from API 28 and `FOREGROUND_SERVICE_DATA_SYNC` from API 34 (this app targets 35) — the type is
      declared again on the service below, because a foreground service whose declared type does not
      contain the runtime type throws on start.
      `POST_NOTIFICATIONS`: the refresh notification is not allowed to interrupt (IMPORTANCE_LOW,
      silent) and Android 13+ additionally asks the user; the request belongs to P2-8's settings page,
      the declaration here just keeps the manifest honest.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android TV: this is a leanback app and does not require a touchscreen. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".IptvApplication"
        android:allowBackup="false"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iptv"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- TV launcher entry -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Phone/tablet launcher entry (same activity; TV is the primary target) -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          P2-5: WorkManager's foreground service. It ships inside work-runtime; `tools:node="merge"`
          makes sure the `dataSync` type (and the exported=false it already has) is what lands in the
          merged manifest, since that is the type `ForegroundInfo` asks for at runtime.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
