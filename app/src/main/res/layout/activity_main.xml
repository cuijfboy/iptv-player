<?xml version="1.0" encoding="utf-8"?>
<!-- P0 placeholder screen: the only navigation that exists is the P0-6 log/device console. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFE6E6E6"
        android:textSize="24sp" />

    <Button
        android:id="@+id/open_log_console"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:focusable="true"
        android:text="@string/open_log_console" />

</LinearLayout>
