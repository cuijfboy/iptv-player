<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen (P0 placeholder, repurposed by P2-9). The router decides within milliseconds and
  finishes this activity, so the screen's only job is to not be a blank frame on a slow cold start.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFE6E6E6"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/launch_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/launch_starting"
        android:textColor="#FFB9B9C6"
        android:textSize="16sp" />

</LinearLayout>
